{
  "name": "dsh-session-rescue",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness session reliability kit: degeneration guard, reasoning-only retry, optional wiretap, inherited recovery sessions, and renderer refresh shortcut.",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=24.9.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "recovery",
    "diagnostics",
    "reasoning"
  ],
  "license": "MIT",
  "author": "Macily",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-session-rescue.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-session-rescue#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-session-rescue/issues"
  }
}
